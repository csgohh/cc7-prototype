# Copy to .env.local for local dev. On Vercel, add these in Project Settings -> Environment Variables.

# Needed for the Kaki voice chatbot (OpenAI Realtime API). Never commit the real key.
# Without it, Kaki falls back to a typed "demo mode" with scripted replies.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the realtime model (default: gpt-realtime)
# OPENAI_REALTIME_MODEL=gpt-realtime

# Number shown on the senior's Hotline screen (demo placeholder).
NURSE_HOTLINE=1800 123 4567
